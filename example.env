# --- OpenRouter API (for VLM + text embeddings) ---------------------------
# Required. Used by VideoQA (Qwen3-VL-8B summary/gist/freeform) and
# by TextEmbedder (text-embedding-3-large) for query-side embeddings.
OPENROUTER_API_KEY=<YOUR OPENROUTER API KEY>

# --- HuggingFace ----------------------------------------------------------
# Used by the visual encoder (CLIP-L) and the grounding model (TRACE).
# Set this even though the models we use are not gated — it improves
# rate-limit headroom during download.
HF_API_KEY=<YOUR HF TOKEN>

# --- LLM provider (planner / supervisor / worker LLMs) --------------------
# One of: AZURE, OPENAI
LLM_PROVIDER=OPENAI

# AZURE branch
AZURE_OPENAI_ENDPOINT=<IF USING AZURE GPTS>
AZURE_OPENAI_API_KEY=<IF USING AZURE GPTS>
OPENAI_API_VERSION=<IF USING AZURE GPTS>

# OPENAI branch
OPENAI_API_KEY=<IF USING OPENAI GPTS>

# --- Storage --------------------------------------------------------------
# Local directory the video-editing worker writes clip outputs to.
HOST_PUBLIC_DIR=/tmp/jockey_videos

# --- Qdrant (vector store for indexed video features) ---------------------
QDRANT_URL=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=  # optional

# --- Thesis training paths (optional — used only by qd_detr_train.py) -----
# QD_DETR_CHECKPOINT=/abs/path/to/runs/qd_detr_iv2/best.pt
# FEATURES_DIR=/abs/path/to/features/charades

# --- AWS S3 (used by scripts/s3_*.py and the /s3-test frontend page) ------
# Real AWS — separate from the local MinIO setup above.
AWS_ACCESS_KEY_ID=<YOUR AWS ACCESS KEY>
AWS_SECRET_ACCESS_KEY=<YOUR AWS SECRET KEY>
AWS_REGION=ap-southeast-1
S3_BUCKET=jockeyassistant
# S3_PRESIGN_TTL=900        # seconds; default 15 min
# S3_BROWSER_PORT=8765      # local FastAPI port for s3_browser.py
