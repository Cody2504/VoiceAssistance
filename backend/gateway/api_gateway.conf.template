upstream iam_upstream         { server iam:1100; }
# VIDEO_UPSTREAM defaults to the local docker network alias. Override via
# .env (VIDEO_UPSTREAM=jockey-vast:1101) when video-service runs on the
# rented vast.ai box and is reached over the Tailscale tailnet.
upstream video_upstream {
    server ${VIDEO_UPSTREAM};
    keepalive 8;
}
upstream agent_upstream       { server agent-service:1102; }
upstream token_usage_upstream { server token-usage:1103; }

server {
    listen 80;
    resolver 127.0.0.11 valid=60s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # Preflight CORS (also allowed at FastAPI layer; nginx returns fast).
    location / {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '$http_origin';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Accept';
            add_header 'Access-Control-Max-Age' 86400;
            add_header 'Access-Control-Allow-Credentials' 'true';
            return 204;
        }
        return 404;
    }

    location =/health { return 200 '{"status":"ok"}'; default_type application/json; }

    # ---- IAM ----
    location /api/v1/auth/  { proxy_pass http://iam_upstream;  include /etc/nginx/conf.d/proxy_headers.inc; }
    location /api/v1/users/ { proxy_pass http://iam_upstream;  include /etc/nginx/conf.d/proxy_headers.inc; }

    # ---- Video service ----
    # Cloudflare-tunneled upstream (video-service on vast). We deliberately
    # skip /etc/nginx/conf.d/proxy_headers.inc here: that include adds
    # X-Forwarded-For with the Docker bridge IP (172.18.x.x), which trips
    # Cloudflare's WAF (private-IP-in-XFF rule) and returns 403. Cloudflare
    # itself sets CF-Connecting-IP for the upstream, so we don't need our own.
    location /api/v1/videos {
        set $video_host video.voiceassistant.uk;
        proxy_pass https://$video_host:443;
        proxy_ssl_server_name on;
        proxy_ssl_name $video_host;
        proxy_set_header Host $video_host;
        proxy_set_header X-Original-URI $request_uri;
    }
    location /api/v1/videos/ {
        set $video_host video.voiceassistant.uk;
        proxy_pass https://$video_host:443;
        proxy_ssl_server_name on;
        proxy_ssl_name $video_host;
        proxy_set_header Host $video_host;
        proxy_set_header X-Original-URI $request_uri;
    }

    # ---- Agent (SSE) ----
    location /api/v1/chat/stream {
        proxy_pass http://agent_upstream;
        include /etc/nginx/conf.d/proxy_headers.inc;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
    }
    location /api/v1/chat/         { proxy_pass http://agent_upstream; include /etc/nginx/conf.d/proxy_headers.inc; }
    location /api/v1/conversations { proxy_pass http://agent_upstream; include /etc/nginx/conf.d/proxy_headers.inc; }
    location /api/v1/conversations/{ proxy_pass http://agent_upstream; include /etc/nginx/conf.d/proxy_headers.inc; }

    # ---- Token usage ----
    location /api/v1/usage  { proxy_pass http://token_usage_upstream; include /etc/nginx/conf.d/proxy_headers.inc; }
    location /api/v1/usage/ { proxy_pass http://token_usage_upstream; include /etc/nginx/conf.d/proxy_headers.inc; }
}
