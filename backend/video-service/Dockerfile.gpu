# GPU build for vast.ai deployment.
#
# Uses the official PyTorch CUDA 12.4 runtime as the base. RTX 3090 / 4090 /
# A100 / H100 all run torch 2.4.1 + cu124 happily. Bump to the 2.6 image only
# if you're targeting RTX 50-series Blackwell (sm_120) — everything else
# stays the same:
#   docker compose -f docker-compose.vast.yml build \
#       --build-arg BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
#
# NB: the bootstrap script (scripts/vast-bootstrap.sh) is the preferred way
# to run on a vast pod — it skips Docker entirely and `uv pip install`s
# everything directly into the pod's existing torch+CUDA environment. This
# Dockerfile is kept for users who actually build & push a GPU image.
ARG BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime
FROM ${BASE_IMAGE} AS base

WORKDIR /app
ENV PYTHONPATH=/app:/shared
ENV HF_HOME=/models/hf-cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libgl1 libglib2.0-0 libsndfile1 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# uv (astral) — faster than pip, used for the remaining installs in this image.
RUN pip install --no-cache-dir uv && uv --version

# Heavy GPU-only deps. Pinned conservatively — adjust on the box if you
# need newer/older.
RUN uv pip install --system --no-cache \
    "pyannote.audio>=3.1" \
    "paddleocr>=2.7" \
    "insightface>=0.7" \
    "onnxruntime-gpu>=1.17" \
    "opencv-python-headless>=4.9"

# PaddlePaddle GPU is platform-conditional and big — keep it as a separate
# layer so a rebuild that only touches application code doesn't redo it.
RUN uv pip install --system --no-cache "paddlepaddle-gpu>=2.6"

COPY backend/cm_shared /shared/cm_shared
COPY backend/video-service /app

# Lighthouse runtime deps + library itself. The library is installed with
# --no-deps because its setup.py pins `numpy<=1.23.5`, which collides with
# the rest of our stack (transformers, decord, scenedetect, ...). All actual
# runtime deps are pinned in /app/requirements.txt at versions that work.
RUN uv pip install --system --no-cache -r /shared/requirements.txt -r /app/requirements.txt \
 && uv pip install --system --no-cache --no-deps \
      "lighthouse-mr @ git+https://github.com/line/lighthouse.git@main"

EXPOSE 1101

CMD ["sh", "-c", "alembic upgrade head && uvicorn main.main:app --host 0.0.0.0 --port 1101"]
