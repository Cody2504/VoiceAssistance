# =========================
# General
# =========================
DEPLOY_ENV=local

# Gateway host port. Default 8085 avoids collision with the Fsoft work-platform
# stack on :85; set GATEWAY_PORT=85 if that stack isn't running on this host.
GATEWAY_PORT=8085
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8085

# HuggingFace token — `huggingface_hub` reads this automatically. Required for
# any gated model (pyannote/speaker-diarization-3.1), and used as a rate-limit
# header for ungated downloads (CLIP, Whisper). Optional locally; required on
# the GPU box if you exercise speaker diarization.
HF_TOKEN=

# Vast.ai host-disk path where /models gets persisted across instance
# destroy+recreate. Override on the vast box; ignored locally.
VAST_MODELS_PATH=/workspace/models

# Whisper ASR engine knobs (faster-whisper / CTranslate2).
# `distil-large-v3` is the default — ~6× faster than `large-v3` at similar WER,
# fits a 4090 comfortably. Set to `base` or `tiny` if you want the smallest
# possible Colab footprint at lower WER on noisy audio.
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true

# JWT
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14

# =========================
# Databases / Stores
# =========================
POSTGRES_USER=jockey
POSTGRES_PASSWORD=jockey_dev
POSTGRES_DB=jockey
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=jockey_shots

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=jockey
MINIO_ROOT_PASSWORD=jockey_dev_secret
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_EDITS=edits
MINIO_BUCKET_THUMBS=thumbs

# =========================
# LLM providers
# =========================
LLM_PROVIDER=OPENAI            # OPENAI | AZURE

OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-4o
OPENAI_WORKER_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-08-01-preview
AZURE_PLANNER_DEPLOYMENT=gpt-4o
AZURE_WORKER_DEPLOYMENT=gpt-4o-mini

# Text embedding (for grounding query side)
OPENROUTER_API_KEY=

# =========================
# Stirrup toggles
# =========================
# local | twelvelabs
STIRRUP_SEARCH=local
STIRRUP_TEXTGEN=local

TWELVE_LABS_API_KEY=

# =========================
# Service internal URLs (container DNS)
# =========================
IAM_BASE_URL=http://iam:1100
VIDEO_SERVICE_BASE_URL=http://video-service:1101
AGENT_SERVICE_BASE_URL=http://agent-service:1102
TOKEN_USAGE_BASE_URL=http://token-usage:1103
BILLING_BASE_URL=http://billing:1104

# =========================
# Billing / Stripe (DEMO — use TEST-mode keys only; no real money moves)
# =========================
# Secret key from the Stripe dashboard in TEST mode (starts with sk_test_).
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...). Not needed for hosted Checkout; kept for parity.
STRIPE_PUBLIC_KEY=
# Recurring monthly Price id for the Developer plan (Product > Price in test mode).
STRIPE_PRICE_DEVELOPER=
# Signing secret printed by `stripe listen --forward-to \
#   localhost:8085/api/v1/billing/webhooks` (starts with whsec_). Lets the
# Stripe CLI tunnel test events to the bare-HTTP gateway — no public HTTPS needed.
STRIPE_WEBHOOK_SECRET=
# Where Stripe-hosted Checkout sends the browser back to (Vite dev server default).
BILLING_SUCCESS_URL=http://localhost:5173/settings/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:5173/settings/billing?checkout=cancelled
