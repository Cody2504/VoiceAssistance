# =========================
# General
# =========================
DEPLOY_ENV=local

# Gateway host port. Default 8085 avoids collision with the Fsoft work-platform
# stack on :85; set GATEWAY_PORT=85 if that stack isn't running on this host.
GATEWAY_PORT=8085
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8085

# Where the gateway proxies /api/v1/videos. Defaults to the in-network alias.
# When video-service runs on the rented vast.ai 4090 box, override with the
# Tailscale IPv4 of that box, e.g. VIDEO_UPSTREAM=100.x.y.z:1101. (MagicDNS
# hostnames don't resolve from bridge-network containers without extra wiring.)
VIDEO_UPSTREAM=video-service:1101

# HF_TOKEN is required for pyannote/speaker-diarization-3.1 (gated model). Set
# only on the GPU box's .env (jockey-vast); not needed locally.
HF_TOKEN=

# Vast.ai host-disk path where /models gets persisted across instance
# destroy+recreate. Override on the vast box; ignored locally.
VAST_MODELS_PATH=/workspace/models

# Whisper ASR engine knobs (faster-whisper / CTranslate2).
# `distil-large-v3` is the default — ~6× faster than `large-v3` at similar WER,
# fits a 4090 comfortably. Set to `base` or `tiny` if you want the smallest
# possible Colab footprint at lower WER on noisy audio.
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true

# JWT
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14

# =========================
# Databases / Stores
# =========================
POSTGRES_USER=jockey
POSTGRES_PASSWORD=jockey_dev
POSTGRES_DB=jockey
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=jockey_shots

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=jockey
MINIO_ROOT_PASSWORD=jockey_dev_secret
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_EDITS=edits
MINIO_BUCKET_THUMBS=thumbs

# =========================
# LLM providers
# =========================
LLM_PROVIDER=OPENAI            # OPENAI | AZURE

OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-4o
OPENAI_WORKER_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-08-01-preview
AZURE_PLANNER_DEPLOYMENT=gpt-4o
AZURE_WORKER_DEPLOYMENT=gpt-4o-mini

# Text embedding (for grounding query side)
OPENROUTER_API_KEY=
HF_API_KEY=

# =========================
# Stirrup toggles
# =========================
# local | twelvelabs
STIRRUP_SEARCH=local
STIRRUP_TEXTGEN=local

TWELVE_LABS_API_KEY=

# =========================
# Service internal URLs (container DNS)
# =========================
IAM_BASE_URL=http://iam:1100
VIDEO_SERVICE_BASE_URL=http://video-service:1101
AGENT_SERVICE_BASE_URL=http://agent-service:1102
TOKEN_USAGE_BASE_URL=http://token-usage:1103
