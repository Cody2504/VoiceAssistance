# vast.env.example — copy to backend/vast.env on the vast.ai pod and fill in.
#
# Read by backend/scripts/vast-bootstrap.sh and exported to the api + worker
# tmux sessions. None of these are baked into the image; everything is config.

# ============================================================================
# Connections back to the laptop (your Mac/WSL2 host) over Cloudflare tunnels.
# Replace the hostnames if your tunnel naming differs.
# ============================================================================

# Postgres (laptop-side jockey-postgres exposed via cloudflared access tcp).
# The bootstrap script runs `alembic upgrade head` against this.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=jockey
POSTGRES_PASSWORD=jockey_dev
POSTGRES_DB=jockey

# Redis (RQ queue + lock store).
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# Qdrant — vector store. From the vast pod hits laptop's qdrant via a tcp
# tunnel (cloudflared access tcp --hostname qdrant.voiceassistant.uk
# --url 127.0.0.1:6333).
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=jockey_shots

# Object store. Either self-hosted MinIO (default, via its Cloudflare hostname)
# OR real AWS S3 for the always-on demo. For the Lightsail demo, point at S3:
#   MINIO_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
#   MINIO_ROOT_USER=<IAM access key id>
#   MINIO_ROOT_PASSWORD=<IAM secret>
#   MINIO_REGION=ap-southeast-1                 # MUST match the bucket region
#   MINIO_BUCKET_VIDEOS=videoassistant-demo     # one shared bucket — all three
#   MINIO_BUCKET_EDITS=videoassistant-demo      # vars point at the same bucket
#   MINIO_BUCKET_THUMBS=videoassistant-demo     # (verified collision-safe)
#   MINIO_PUBLIC_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
MINIO_ENDPOINT=https://minio.voiceassistant.uk
MINIO_ROOT_USER=jockey
MINIO_ROOT_PASSWORD=jockey_dev_secret
MINIO_REGION=us-east-1

# ============================================================================
# API keys
# ============================================================================

# OpenRouter — used by the VLM (Qwen3-VL captions, video QA) and text
# embeddings (text-embedding-3-large). Required.
OPENROUTER_API_KEY=

# HuggingFace token — `huggingface_hub` reads it automatically. Required for
# gated models (e.g. pyannote/speaker-diarization-3.1) and used as a rate-
# limit header for ungated downloads (CLIP, Whisper).
HF_TOKEN=

# Optional — only if your stirrups call OpenAI directly (most flows go via
# OpenRouter, so this can stay empty).
OPENAI_API_KEY=

# ============================================================================
# Service tuning
# ============================================================================

# Force GPU on the vast box; falls back to CPU if no CUDA driver is visible.
LIGHTHOUSE_DEVICE=cuda

# Number of parallel RQ workers consuming the video_index queue. Each worker
# loads its own copy of the heavy models (Lighthouse + ViCLIP + Whisper + ...)
# into VRAM — roughly 8 GB at idle, plus activations during inference.
#   • RTX 3090 / 4090 (24 GB): 2 is the comfortable sweet spot, 3 is the ceiling
#   • A100 40 GB / H100 80 GB: 3-4
#   • smaller GPUs (≤12 GB): 1
WORKER_COUNT=2

# torch / CUDA expectations enforced by the bootstrap preflight. The vast
# pytorch:2.4.1-cuda12.4-cudnn9-runtime image satisfies these out of the box.
# Bump TORCH_MIN_VERSION to 2.6 for RTX 50-series (Blackwell sm_120).
TORCH_MIN_VERSION=2.4
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# Public path where the browser will fetch your MinIO objects. Used when the
# api signs presigned URLs (browser ↔ MinIO direct, not via the api).
MINIO_PUBLIC_ENDPOINT=https://minio.voiceassistant.uk

# Where Lighthouse weights live. The bootstrap script downloads here.
MODELS_DIR=/workspace/models

# Set to 1 to also install the heavy optional segmenters (pyannote speaker
# diarization, PaddleOCR on-screen text, InsightFace person-of-focus). Adds
# ~1.5 GB to the image and ~5 min to install time. Leave unset / 0 if you
# only need the core MR / HD / Q&A flow.
INSTALL_SEGMENTERS=0
