VITE_API_BASE_URL=http://localhost:8085/api/v1
# Standalone /s3-test page backend (scripts/s3_browser.py); leave unset to use the default.
# VITE_S3_BROWSER_URL=http://localhost:8765
# Google OAuth Web Client ID (from Google Cloud Console). Set this (here or in
# .env.local) to show the "Continue with Google" button. Must match
# GOOGLE_CLIENT_ID on the iam backend. Left commented so it never overrides a
# value set in .env.local (Vite gives .env.development higher precedence).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
