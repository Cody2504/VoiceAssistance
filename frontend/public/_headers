# Cloudflare Pages headers.
# index.html must always be revalidated so a new deploy is picked up on the next
# visit (the hashed JS/CSS it references are immutable, so this is safe + cheap).
# Without this, browsers can keep serving a stale index.html that points at an old
# bundle — which is why new features sometimes didn't appear until a hard refresh.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Fingerprinted build assets never change for a given hash → cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
